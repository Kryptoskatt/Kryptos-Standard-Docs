{"parameters":[{"name":"wid","in":"query","required":false,"schema":{"type":"string"},"description":"Not needed: the workspace comes from your token. If you send it, it must be your `workspace_id`."},{"name":"rates","in":"query","schema":{"type":"string","enum":["true","false"],"default":"true"},"description":"Include live prices"},{"name":"search","in":"query","schema":{"type":"string"}},{"name":"sortBy","in":"query","schema":{"type":"string","enum":["value","quantity","name","24hrChange","txnCount"],"default":"value"}},{"name":"sortOrder","in":"query","schema":{"type":"string","enum":["asc","desc"],"default":"desc"}},{"name":"type","in":"query","schema":{"type":"string","enum":["all","xstocks"]},"description":"Ecosystem filter. `all` (or omitted) = no filter. `xstocks` = only xStock (Backed Finance tokenized equity) holdings."},{"name":"assetIds","in":"query","schema":{"type":"string"},"description":"Comma-separated asset IDs"},{"name":"integrationId","in":"query","schema":{"type":"string"}},{"name":"minValue","in":"query","schema":{"type":"number","minimum":0},"description":"Hide holdings with market value below this USD threshold"},{"name":"includeSpam","in":"query","schema":{"type":"boolean","default":false}},{"name":"offset","in":"query","schema":{"type":"integer","default":0}},{"name":"limit","in":"query","schema":{"type":"integer","default":50,"maximum":1000}}]}